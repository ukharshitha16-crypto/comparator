`timescale 1ns/1ps

module comparator_tb;

reg [1:0] A;
reg [1:0] B;

wire A_greater;
wire A_equal;
wire A_less;

comparator uut (
    .A(A),
    .B(B),
    .A_greater(A_greater),
    .A_equal(A_equal),
    .A_less(A_less)
);

initial begin
    $monitor("Time=%0t A=%b B=%b Greater=%b Equal=%b Less=%b",
             $time, A, B, A_greater, A_equal, A_less);

    A = 2'b00; B = 2'b00; #10;
    A = 2'b01; B = 2'b00; #10;
    A = 2'b10; B = 2'b11; #10;
    A = 2'b11; B = 2'b11; #10;
    A = 2'b10; B = 2'b01; #10;

    $finish;
end

endmodule